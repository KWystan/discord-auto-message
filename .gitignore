# Dependencies
node_modules/

# Build output
dist/
.vercel/

# Python
server/venv/
__pycache__/
*.pyc

# Local environment / secrets (never commit real credentials)
server/.env

# Firebase service account (never commit)
server/firebase-service-account.json
server/*firebase-adminsdk*.json

# App data — contains tokens, webhooks, channel IDs (runtime state, not source)
app_data.json
app_data-*.json

# Local user accounts fallback (password hashes) when Firebase is unavailable
server/users.json

# Agent instruction files
AGENTS.md
CLAUDE.md
COPILOT.md

# Logs / editor / OS
*.log
.DS_Store
Thumbs.db
Desktop.ini

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
