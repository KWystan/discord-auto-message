# Example configuration. Copy to .env and adjust for local development.
# Never commit .env — it may contain real credentials.
PORT=5000
FLASK_DEBUG=0

# Firebase / Firestore persistence (optional — if not configured the engine
# falls back to the local app_data.json file).
# Leave FIREBASE_SERVICE_ACCOUNT_PATH empty to auto-detect
# server/firebase-service-account.json.
FIREBASE_ENABLED=1
FIREBASE_SERVICE_ACCOUNT_PATH=
FIRESTORE_COLLECTION=discordautomsg
FIRESTORE_DOC=app_data

# Session signing key — change this to a random string.
SECRET_KEY=dev-insecure-secret-change-me

# Discord OAuth (login gate). Create an app at
# https://discord.com/developers/applications -> OAuth2, then:
#   1. Copy the Client ID / Client Secret here.
#   2. Add redirect URI: http://localhost:5000/api/auth/callback
#   3. Scopes used: identify webhook.incoming (the user's servers are never requested)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The fixed target server + channel (the only place messages are sent).
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/callback
FRONTEND_URL=http://localhost:5173
