{
  "name": "discordautomsg",
  "private": true,
  "version": "0.0.1",
  "description": "Discord Auto Message — React (client/) + Flask (server/) web app",
  "scripts": {
    "setup": "npm install && node scripts/setup.cjs",
    "dev": "npm --prefix client run dev",
    "api": "node scripts/api.cjs",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "check": "node scripts/check.cjs",
    "preview": "npm --prefix client run preview",
    "serve": "npm run build && node scripts/api.cjs",
    "start": "concurrently -n client,api -c blue,green \"npm run dev\" \"npm run api\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
