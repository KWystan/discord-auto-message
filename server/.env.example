# Example configuration. Copy to .env and adjust for local development.
# Never commit .env — it may contain real credentials.
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=0
AUTOMSG_DATA_FILE=

# Firebase / Firestore persistence (optional — if not configured the engine
# falls back to the local app_data.json file).
# Leave FIREBASE_SERVICE_ACCOUNT_PATH empty to auto-detect
# server/firebase-service-account.json.
FIREBASE_ENABLED=1
# For Vercel, paste the complete service-account JSON as one environment value.
# Use this OR FIREBASE_SERVICE_ACCOUNT_PATH, not both.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIRESTORE_COLLECTION=discordautomsg
FIRESTORE_DOC=app_data

# Session signing key — use a stable random value outside local development.
SECRET_KEY=change-this-to-a-random-value

# Fixed target server + fallback channel used by the server scan.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
